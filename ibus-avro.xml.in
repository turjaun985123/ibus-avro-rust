<?xml version="1.0" encoding="utf-8"?>
<!-- filename: ibus-avro.xml -->
<component>
	<name>org.freedesktop.IBus.Avro</name>
	<description>Avro Phonetic</description>
	<exec>${libexecdir}/avro-phonetic-ibus --service-name=org.freedesktop.IBus.Avro --engine-name=ibus-avro --preferences-dir=${pkgdatadir}</exec>
	<version>1.1</version>
	<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
	<license>MPL 2.0</license>
	<homepage>https://github.com/turjaun985123/ibus-avro-rust</homepage>
	<textdomain>ibus-avro</textdomain>

	<engines>
		<engine>
			<name>ibus-avro</name>
			<language>bn</language>
			<license>MPL</license>
			<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
			<icon>${pkgdatadir}/avro-bangla.png</icon>
			<layout>us</layout>
			<longname>Avro Phonetic</longname>
			<description>Avro Phonetic Input Method</description>
			<setup>/usr/bin/env gjs --include-path=${pkgdatadir} ${pkgdatadir}/pref.js --standalone</setup>
			<rank>0</rank>
		</engine>
	</engines>

</component>
