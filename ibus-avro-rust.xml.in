<?xml version="1.0" encoding="utf-8"?>
<component>
	<name>org.freedesktop.IBus.AvroRust</name>
	<description>Avro Phonetic (Rust)</description>
	<exec>${libexecdir}/avro-phonetic-ibus --service-name=org.freedesktop.IBus.AvroRust --engine-name=ibus-avro-rust</exec>
	<setup>/usr/bin/env gjs --include-path=${pkgdatadir} ${pkgdatadir}/pref.js --standalone</setup>
	<version>0.1</version>
	<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
	<license>MPL 2.0</license>
	<homepage>https://github.com/turjaun985123/ibus-avro-rust</homepage>

	<engines>
		<engine>
			<name>ibus-avro-rust</name>
			<language>bn</language>
			<license>MPL</license>
			<author>Sarim Khan &lt;sarim2005@gmail.com&gt;</author>
			<icon>${pkgdatadir}/avro-bangla.png</icon>
			<layout>us</layout>
			<longname>Avro Phonetic (Rust)</longname>
			<description>Experimental Rust Avro phonetic engine</description>
			<rank>0</rank>
		</engine>
	</engines>
</component>
